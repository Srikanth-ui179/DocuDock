# Supabase Public Configuration (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (Used only for server-side admin tasks if required)
# NEVER expose this key to client-side code!
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Note: AI Provider keys (Google Gemini & OpenAI) are NOT stored in environment variables or databases.
# Users provide their own keys in the application interface, held securely in browser memory only.
